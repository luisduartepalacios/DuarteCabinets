---
/**
 * Duarte Cabinets & Design — official wordmark logo (vectorized from the brand mark).
 * Inherits `currentColor`, so set the parent's `color` to recolor it
 * (forest on light surfaces, cream/sand on dark). `markColor` forces a color.
 */
interface Props {
  variant?: 'full' | 'stacked' | 'mark';
  class?: string;
  markColor?: string;
}
const { variant = 'full', class: className = '', markColor } = Astro.props;
---

<span
  class={`logo logo--${variant} ${className}`}
  style={markColor ? `color:${markColor}` : undefined}
  aria-label="Duarte Cabinets & Design"
>
