---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Eager-load the first few above-the-fold cards. */
  eager?: boolean;
  sizes?: string;
}
const { project, eager = false, sizes = '(max-width: 760px) 100vw, 50vw' } = Astro.props;
const cover = project.images[0];
---

<a href={`/projects/${project.slug}`} class="project-card" data-type={project.type}>
  <div class="project-card__media">
    {cover && (
      <Image
        src={cover}
        alt={`${project.title} — ${project.category} by Duarte Cabinets & Design`}
        widths={[480, 760, 1100, 1500]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="project-card__img"
      />
    )}
    <span class="project-card__count">{project.images.length} views</span>
  </div>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{project.category}</span>
      <span class="project-card__dot" aria-hidden="true">·</span>
      <span>{project.location}</span>
    </div>
    <h3 class="project-card__title">{project.title}</h3>
    <p class="project-card__blurb">{project.blurb}</p>
  </div>
</a>

<style>
  .project-card {
    display: block;
  }
  .project-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    background: var(--color-cream-soft);
  }
  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), filter 0.9s var(--ease);
  }
  .project-card:hover .project-card__img {
    transform: scale(1.045);
  }
  .project-card__count {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-cream);
    background: rgba(22, 33, 30, 0.55);
    backdrop-filter: blur(4px);
    padding: 0.4em 0.85em;
    border-radius: 100px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .project-card:hover .project-card__count { opacity: 1; transform: none; }

  .project-card__body { padding-top: 1.25rem; }
  .project-card__meta {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-rust);
  }
  .project-card__dot { color: var(--text-muted); }
  .project-card__title {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    margin-top: 0.5rem;
    transition: color 0.3s var(--ease);
  }
  .project-card:hover .project-card__title { color: var(--color-rust); }
  .project-card__blurb {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.98rem;
    max-width: 42ch;
  }
</style>
