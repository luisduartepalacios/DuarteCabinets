---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, services } from '../data/site';

const formAction = `https://formspree.io/f/${site.formspreeId}`;
---

<BaseLayout
  title="Contact"
  description="Start a project with Duarte Cabinets & Design. Tell us about your space and we’ll be in touch."
>
  <section class="section--tight contact">
    <div class="container contact__grid">
      <!-- Left: invitation + details -->
      <div class="contact__aside">
        <p class="eyebrow">Contact</p>
        <h1 class="contact__title display">Let’s start a project.</h1>
        <p class="contact__lead lead">
          Tell us a little about your space and what you have in mind. We read every inquiry
          and typically reply within two business days.
        </p>

        <ul role="list" class="contact__details">
          <li>
            <span class="contact__label">Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="contact__label">Phone</span>
            <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <span class="contact__label">Instagram</span>
            <a href={site.instagramUrl} target="_blank" rel="noopener">@{site.instagram}</a>
          </li>
          <li>
            <span class="contact__label">Studio</span>
            <span>{site.locationLine}</span>
          </li>
        </ul>
      </div>

      <!-- Right: form -->
      <div class="contact__form-wrap">
        <form
          class="contact-form"
          action={formAction}
          method="POST"
          data-form
        >
          <div class="field">
            <label for="name">Name <span class="field__req" aria-hidden="true">*</span></label>
            <input type="text" id="name" name="name" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">Email <span class="field__req" aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="phone">Phone <span class="field__opt">(optional)</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" />
          </div>

          <div class="field">
            <label for="service">What can we help with? <span class="field__req" aria-hidden="true">*</span></label>
            <div class="select-wrap">
              <select id="service" name="service" required>
                <option value="" disabled selected>Select a service…</option>
                {services.map((s) => <option value={s.name}>{s.name}</option>)}
                <option value="Not sure yet">Not sure yet</option>
              </select>
              <svg class="select-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.4"/></svg>
            </div>
          </div>

          <div class="field">
            <label for="message">Tell us about your project <span class="field__req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required
              placeholder="Your space, rough timeline, and what you’re hoping to achieve…"></textarea>
          </div>

          <!-- Honeypot anti-spam (hidden from users) -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <input type="hidden" name="_subject" value="New project inquiry — Duarte Cabinets" />

          <button type="submit" class="btn btn--primary contact-form__submit" data-submit>
            Send inquiry
          </button>

          <p class="contact-form__status" data-status hidden role="status"></p>
        </form>

        {site.formspreeId === 'XXXXXXXX' && (
          <p class="contact-form__note">
            ⚠︎ Set up a free form at <a href="https://formspree.io" target="_blank" rel="noopener">formspree.io</a>
            and replace <code>formspreeId</code> in <code>src/data/site.ts</code> to receive submissions.
          </p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-top: clamp(2.5rem, 2rem + 3vw, 5rem); }
  .contact__grid {
    display: grid; grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 1.5rem + 5vw, 6rem); align-items: start;
  }
  .contact__title { margin: 0.75rem 0 1.5rem; }
  .contact__lead { color: var(--text-muted); max-width: 36ch; }
  .contact__details {
    display: flex; flex-direction: column; gap: 1.25rem;
    margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--hairline);
  }
  .contact__details li { display: flex; flex-direction: column; gap: 0.25rem; }
  .contact__label { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); }
  .contact__details a { color: var(--color-forest); transition: color 0.3s var(--ease); }
  .contact__details a:hover { color: var(--color-rust); }

  /* Form */
  .contact-form { display: flex; flex-direction: column; gap: 1.5rem; }
  .field { display: flex; flex-direction: column; gap: 0.5rem; }
  .field label {
    font-size: 0.76rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-forest); font-weight: 400;
  }
  .field__opt {
    text-transform: none; letter-spacing: 0; font-weight: 300;
    color: var(--text-muted); margin-left: 0.4em;
  }
  .field__req { color: var(--color-rust); margin-left: 0.1em; }
  input, select, textarea {
    font-family: var(--font-sans); font-size: 1rem; font-weight: 300;
    color: var(--color-forest);
    background: var(--color-white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.95em 1.1em;
    width: 100%;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  input::placeholder, textarea::placeholder { color: #9aa39d; }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--color-forest);
    box-shadow: 0 0 0 3px rgba(30,45,41,0.08);
  }
  textarea { resize: vertical; min-height: 140px; }
  .select-wrap { position: relative; }
  select { appearance: none; -webkit-appearance: none; cursor: pointer; padding-right: 2.5rem; }
  .select-arrow { position: absolute; right: 1.1rem; top: 50%; transform: translateY(-50%); color: var(--color-forest); pointer-events: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .contact-form__submit { align-self: flex-start; min-width: 200px; justify-content: center; }
  .contact-form__submit[disabled] { opacity: 0.6; cursor: progress; }
  .contact-form__status { font-size: 0.95rem; padding: 0.5rem 0; }
  .contact-form__status[data-state='ok'] { color: var(--color-olive); }
  .contact-form__status[data-state='error'] { color: var(--color-rust); }
  .contact-form__note {
    margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);
    background: var(--color-cream-soft); padding: 1rem 1.25rem; border-radius: var(--radius);
    border: 1px dashed var(--hairline);
  }
  .contact-form__note code { font-size: 0.85em; background: rgba(30,45,41,0.08); padding: 0.1em 0.4em; border-radius: 3px; }

  @media (max-width: 880px) {
    .contact__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Progressive enhancement: AJAX submit to Formspree with inline success/error,
  // so the visitor stays on the page. Falls back to a normal POST if JS is off.
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');

  const defaultLabel = submit?.textContent ?? 'Send inquiry';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (status) { status.hidden = false; status.removeAttribute('data-state'); status.textContent = 'Sending…'; }
    if (submit) { submit.disabled = true; submit.textContent = 'Sending…'; }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        if (status) { status.dataset.state = 'ok'; status.textContent = 'Thank you, your inquiry is on its way. We’ll be in touch soon.'; }
        if (submit) { submit.disabled = false; submit.textContent = 'Sent ✓'; }
      } else {
        // Surface Formspree's validation message when available.
        const data = await res.json().catch(() => null);
        const msg = data?.errors?.map((err: { message: string }) => err.message).join(', ');
        throw new Error(msg || 'Bad response');
      }
    } catch (err) {
      if (status) {
        status.dataset.state = 'error';
        status.textContent =
          (err instanceof Error && err.message && err.message !== 'Bad response')
            ? err.message
            : 'Something went wrong. Please email us directly and we’ll sort it out.';
      }
      if (submit) { submit.disabled = false; submit.textContent = defaultLabel; }
    }
  });
</script>
