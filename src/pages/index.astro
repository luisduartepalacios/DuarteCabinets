---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects, projects } from '../data/projects';
import { site, services } from '../data/site';

const heroImage = featuredProjects[0].images[0];
const aboutImage = projects.find((p) => p.slug === 'cocina-julian')?.images[0];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__media">
      <Image
        src={heroImage}
        alt="A light-filled custom kitchen by Duarte Cabinets & Design"
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__scrim"></div>
    </div>
    <div class="hero__content container">
      <p class="eyebrow hero__eyebrow">Custom Cabinetry &amp; Interior Design</p>
      <h1 class="hero__title display">
        Smart spaces,<br />made to measure.
      </h1>
      <p class="hero__lead">
        A binational design studio crafting bespoke kitchens, closets, and commercial
        spaces — where considered design meets signature carpentry.
      </p>
      <div class="hero__actions">
        <a href="/projects" class="btn btn--primary">View the portfolio</a>
        <a href="/contact" class="btn btn--outline">Start a project</a>
      </div>
    </div>
    <a href="#featured" class="hero__scroll" aria-label="Scroll to featured work">
      <span></span>
    </a>
  </section>

  <!-- ============ INTRO STATEMENT ============ -->
  <section class="section intro">
    <div class="container container--narrow intro__inner reveal">
      <p class="eyebrow">The Studio</p>
      <p class="intro__statement display">
        We believe a well-made space should feel as good as it looks. Every piece is
        designed and built for one room, one client — never off the shelf.
      </p>
      <a href="/about" class="link-arrow">
        Meet the studio
        <svg width="22" height="10" viewBox="0 0 22 10" fill="none" aria-hidden="true"><path d="M0 5h20M16 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
      </a>
    </div>
  </section>

  <!-- ============ FEATURED PROJECTS ============ -->
  <section class="section featured" id="featured">
    <div class="container">
      <div class="featured__head reveal">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h2>Featured projects</h2>
        </div>
        <a href="/projects" class="link-arrow featured__all">
          All projects
          <svg width="22" height="10" viewBox="0 0 22 10" fill="none" aria-hidden="true"><path d="M0 5h20M16 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
        </a>
      </div>

      <div class="featured__grid">
        {featuredProjects.map((project, i) => (
          <div class={`reveal featured__item featured__item--${i % 2 === 0 ? 'a' : 'b'}`}>
            <ProjectCard project={project} eager={i < 2} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 620px" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SERVICES STRIP ============ -->
  <section class="section on-dark services-strip">
    <div class="container">
      <div class="services-strip__head reveal">
        <p class="eyebrow">How we work</p>
        <h2>Three ways to design together</h2>
      </div>
      <div class="services-strip__grid">
        {services.map((s, i) => (
          <a href="/services" class="service-cell reveal">
            <span class="service-cell__num">0{i + 1}</span>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            <span class="link-arrow service-cell__link">
              Learn more
              <svg width="22" height="10" viewBox="0 0 22 10" fill="none" aria-hidden="true"><path d="M0 5h20M16 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ABOUT / FOUNDER ============ -->
  <section class="section founder">
    <div class="container founder__inner">
      {aboutImage && (
        <div class="founder__media reveal">
          <Image
            src={aboutImage}
            alt="Warm walnut kitchen detail by Duarte Cabinets & Design"
            widths={[480, 760, 1100]}
            sizes="(max-width: 880px) 100vw, 45vw"
            loading="lazy"
            class="founder__img"
          />
        </div>
      )}
      <div class="founder__text reveal">
        <p class="eyebrow">About</p>
        <h2>Design with intention, built to last.</h2>
        <p class="lead">
          Duarte Cabinets &amp; Design is the studio of {site.designer} — an integral
          designer who brings architecture, interiors, and custom millwork under one
          accountable roof.
        </p>
        <p>
          From a first sketch to the final installed cabinet, we keep the process close and
          personal. The result is a space that is functional, dignified, and full of life —
          delivered with honest craft at a fair price.
        </p>
        <a href="/about" class="btn btn--outline">Our story</a>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIAL ============ -->
  <section class="section quote on-dark">
    <div class="container container--narrow quote__inner reveal">
      <p class="quote__mark" aria-hidden="true">“</p>
      <blockquote class="quote__text display">
        They translated everything we imagined into a space that works harder and feels
        warmer than we thought possible. The craftsmanship is exceptional.
      </blockquote>
      <p class="quote__cite">— A Duarte homeowner, Tijuana</p>
    </div>
  </section>

  <!-- ============ CTA BANNER ============ -->
  <section class="section cta-banner">
    <div class="container container--narrow cta-banner__inner reveal">
      <h2 class="display">Have a space in mind?</h2>
      <p class="lead">
        Tell us about your project. Whether it’s a single kitchen or a full renovation,
        we’d love to hear what you’re dreaming up.
      </p>
      <a href="/contact" class="btn btn--primary">Start a project</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: min(92vh, 880px);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(22,33,30,0.78) 0%, rgba(22,33,30,0.25) 42%, rgba(22,33,30,0.15) 100%);
  }
  .hero__content { padding-bottom: clamp(3.5rem, 2rem + 6vw, 7rem); max-width: 880px; }
  .hero__eyebrow { color: var(--color-sand); }
  .hero__title {
    font-size: var(--fs-hero);
    color: var(--color-cream);
    margin: 1rem 0 1.5rem;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    font-weight: 300;
    max-width: 46ch;
    color: rgba(243, 237, 225, 0.9);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }
  .hero__scroll {
    position: absolute;
    left: 50%; bottom: 1.5rem;
    transform: translateX(-50%);
    width: 24px; height: 38px;
    border: 1px solid rgba(243,237,225,0.5);
    border-radius: 20px;
  }
  .hero__scroll span {
    position: absolute; left: 50%; top: 8px;
    width: 3px; height: 7px;
    background: var(--color-sand);
    border-radius: 2px;
    transform: translateX(-50%);
    animation: scrolldot 1.8s var(--ease) infinite;
  }
  @keyframes scrolldot { 0%{opacity:0;transform:translate(-50%,0)} 40%{opacity:1} 80%{opacity:0;transform:translate(-50%,12px)} 100%{opacity:0} }

  /* ---------- INTRO ---------- */
  .intro__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .intro__statement {
    font-size: clamp(1.6rem, 1.1rem + 2.4vw, 2.75rem);
    line-height: 1.18;
    color: var(--color-forest);
    max-width: 24ch;
  }

  /* ---------- FEATURED ---------- */
  .featured__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .featured__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  /* Editorial offset rhythm on desktop */
  @media (min-width: 881px) {
    .featured__item--b { transform: translateY(3.5rem); }
  }

  /* ---------- SERVICES STRIP ---------- */
  .services-strip__head { margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem); max-width: 30ch; }
  .services-strip__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline-light);
    border: 1px solid var(--hairline-light);
  }
  .service-cell {
    background: var(--color-forest);
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: background 0.4s var(--ease);
  }
  .service-cell:hover { background: var(--color-forest-deep); }
  .service-cell__num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-sand);
  }
  .service-cell h3 { color: var(--color-cream); }
  .service-cell p { color: rgba(243,237,225,0.7); font-size: 0.98rem; flex: 1; }
  .service-cell__link { margin-top: 0.5rem; font-size: 0.74rem; }

  /* ---------- FOUNDER ---------- */
  .founder__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: center;
  }
  .founder__media { overflow: hidden; border-radius: var(--radius); }
  .founder__img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .founder__text { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .founder__text h2 { max-width: 16ch; }
  .founder__text .btn { margin-top: 0.75rem; }

  /* ---------- QUOTE ---------- */
  .quote { background: var(--color-slate); }
  .quote__inner { text-align: center; }
  .quote__mark {
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 0.5;
    color: var(--color-sand);
    margin-bottom: 1rem;
  }
  .quote__text {
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.4rem);
    line-height: 1.3;
    color: var(--color-cream);
    font-weight: 500;
  }
  .quote__cite {
    margin-top: 1.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(243,237,225,0.75);
  }

  /* ---------- CTA ---------- */
  .cta-banner__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .cta-banner h2 { font-size: var(--fs-h1); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 880px) {
    .featured__grid { grid-template-columns: 1fr; }
    .services-strip__grid { grid-template-columns: 1fr; }
    .founder__inner { grid-template-columns: 1fr; }
    .founder__media { order: -1; }
    .founder__img { aspect-ratio: 16/10; }
    .hero { min-height: 88vh; }
  }
</style>
