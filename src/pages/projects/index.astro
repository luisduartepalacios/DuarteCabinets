---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, projectTypes } from '../../data/projects';
---

<BaseLayout
  title="Portfolio"
  description="Custom kitchens, closets, and commercial spaces by Duarte Cabinets & Design — a binational interior design and cabinetry studio."
>
  <!-- Page header -->
  <section class="section--tight page-head">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1 class="page-head__title display">Selected work</h1>
      <p class="page-head__lead lead">
        A growing collection of bespoke kitchens, dressing rooms, and commercial spaces —
        each designed and built to measure.
      </p>
    </div>
  </section>

  <!-- Filter -->
  <section class="section--tight projects">
    <div class="container">
      <div class="filter" role="tablist" aria-label="Filter projects by type">
        {projectTypes.map((type, i) => (
          <button
            class:list={['filter__btn', { 'is-active': i === 0 }]}
            data-filter={type}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {type}
          </button>
        ))}
      </div>

      <div class="projects__grid" data-grid>
        {projects.map((project, i) => (
          <div class="projects__item reveal" data-type={project.type}>
            <ProjectCard
              project={project}
              eager={i < 2}
              sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 600px"
            />
          </div>
        ))}
      </div>
      <p class="projects__empty" data-empty hidden>No projects in this category yet.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding-top: clamp(2.5rem, 2rem + 3vw, 5rem); }
  .page-head__title { margin: 0.75rem 0 1.25rem; }
  .page-head__lead { max-width: 50ch; color: var(--text-muted); }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 1.5rem;
  }
  .filter__btn {
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 100px;
    padding: 0.6em 1.4em;
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: all 0.35s var(--ease);
  }
  .filter__btn:hover { color: var(--color-forest); border-color: var(--color-forest); }
  .filter__btn.is-active {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .projects__item[hidden] { display: none; }
  .projects__empty { text-align: center; padding: 3rem 0; color: var(--text-muted); }

  @media (max-width: 760px) {
    .projects__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.projects__item');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.filter;
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      let shown = 0;
      items.forEach((item) => {
        const match = type === 'All' || item.dataset.type === type;
        item.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  });
</script>
